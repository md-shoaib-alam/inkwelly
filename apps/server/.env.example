# ─── INFRASTRUCTURE (RENDER) ──────────────────────────────────
NODE_ENV=production
PORT=4000
# Connection to your production DB (e.g., Supabase or Render Postgres)
DATABASE_URL=postgresql://user:password@hostname:port/dbname?sslmode=require
# Required when running docker-compose.yml (Postgres + PgBouncer). Use a strong, unique password.
DB_PASSWORD=change_me_strong_db_password
# Connection to your production Redis (e.g., Upstash or Render Redis)
# IMPORTANT: This Redis is shared with BullMQ. It MUST use maxmemory-policy=noeviction
# (set it in the provider dashboard — CONFIG SET is blocked on managed Redis).
# An LRU/LFU policy would evict queue/job data and silently lose background jobs.
# Prefer rediss:// (TLS) in production.
REDIS_URL=redis://default:password@hostname:port

# ─── AUTH & SECURITY ──────────────────────────────────────────
# Use a strong, unique 32+ character string
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
# Your frontend URL (e.g., https://your-school-app.vercel.app)
CORS_ORIGIN=https://your-frontend-domain.com

# ─── MONITORING ─────────────────────────────────────────────
LOG_LEVEL=info
# Set to 'true' to disable pretty colors in Render's logs (cleaner output)
DISABLE_PRETTY_LOG=true
SENTRY_DSN=https://your-sentry-dsn.com
POSTHOG_API_KEY=phc_your_key_here
POSTHOG_HOST=https://us.i.posthog.com

# ─── PAYMENTS (RAZORPAY) ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── STORAGE (CLOUDFLARE R2 / S3) ───────────────────────────
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ─── FIREBASE ADMIN ──────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# IMPORTANT: On Render, you can paste the full multi-line key including 
# the BEGIN and END tags. Wrap it in double quotes if using a .env file locally.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----"

# ─── BACKGROUND WORKERS ──────────────────────────────────────
# Set to true if you want BullMQ workers to run in this same process
START_WORKERS=true

# ─── INTEGRATION CREDENTIALS ─────────────────────────────────
# Encrypts third-party API keys at rest (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the integrations API refuses to save credentials.
INTEGRATION_ENCRYPTION_KEY=
