{
  "name": "@inkwelly/server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:full": "bun run src/db/full_seed_data.ts",
    "db:backfill:years": "bun run src/db/backfill_academic_years.ts",
    "db:backfill:class-slugs": "bun run src/db/backfill_class_slugs.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.5",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/bun": "^10.72.0",
    "@sinclair/typebox": "^0.34.52",
    "bullmq": "^5.81.4",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "elysia-helmet": "^3.1.0",
    "firebase-admin": "^14.3.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.10",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "posthog-node": "^5.51.4",
    "razorpay": "^2.9.8",
    "uuid": "^14.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "overrides": {
    "axios": "^1.18.0"
  }
}
